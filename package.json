{
  "name": "krusch-companion",
  "version": "1.0.0",
  "type": "module",
  "description": "Sovereign, privacy-first personal AI assistant and daily companion integrating KruschContext working memory with Krusch Cascade Router",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./tools": "./src/agent/tools.js",
    "./proxy": "./src/agent/agentic-proxy.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "doctor": "node scripts/doctor.js",
    "bench": "node scripts/benchmark.js",
    "lint": "npm --prefix client run lint",
    "test": "node --test tests/*.js"
  },
  "dependencies": {
    "krusch-cascade-router": "^1.1.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1"
  },
  "author": "kruschdev",
  "license": "MIT"
}
