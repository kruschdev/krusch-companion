# Krusch Companion Environment Configuration
PORT=3004
NODE_ENV=development

# LLM Providers (Local First)
OLLAMA_HOST=http://127.0.0.1:11434
SWARM_VLLM_URL=http://127.0.0.1:8000/v1

# Privacy / Escalation Gate (strictly false by default)
ALLOW_CLOUD_ESCALATION=false

# Optional Cloud Keys (Only used if ALLOW_CLOUD_ESCALATION=true)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Local Whisper STT
WHISPER_HOST=localhost
WHISPER_PORT=9000
